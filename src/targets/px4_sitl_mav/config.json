{
  "name": "px4_sitl_mav",
  "basic": {
    "ros_pkg": "px4",
    "ros_node": "drone"
  },
  "lifecycle": {
    "managed": true,
    "warmup_sec": 10.0,
    "install_script": "install.sh",
    "verify_cmd": "ros2 interface show px4_msgs/msg/ManualControlSetpoint >/dev/null",
    "skip_ros_pkg_check": true,
    "start_cmd": "bash -lc \"PX4_DIR=${PX4_DIR:-/robofuzz/src/targets/PX4-Autopilot}; [ -x ${PX4_DIR}/Tools/sitl_run.sh ] || { echo PX4-Autopilot-not-found; exit 1; }; ${PX4_DIR}/Tools/sitl_run.sh ${PX4_DIR}/build/px4_sitl_rtps/bin/px4 none gazebo none none ${PX4_DIR} ${PX4_DIR}/build/px4_sitl_rtps\"",
    "stop_cmd": "pkill -f \"px4\" || true; pkill -f gzserver || true; pkill -f gzclient || true"
  },
  "fuzzing": {
    "default_topic": "/dummy_mavlink_topic",
    "default_msg_type": "px4_msgs/msg/ManualControlSetpoint",
    "field_whitelist": [
      [
        "x",
        "float32"
      ],
      [
        "y",
        "float32"
      ],
      [
        "z",
        "float32"
      ],
      [
        "r",
        "float32"
      ]
    ],
    "feedback": [
      {
        "name": "imu_accel_inconsistency",
        "type": "INC"
      },
      {
        "name": "imu_gyro_inconsistency",
        "type": "INC"
      },
      {
        "name": "gps_lat_inconsistency",
        "type": "INC"
      },
      {
        "name": "gps_lon_inconsistency",
        "type": "INC"
      }
    ]
  },
  "monitoring": {
    "watchlist": "watchlist.json",
    "plugin": "plugin.py"
  },
  "runtime": {
    "px4_sitl": true,
    "px4_ros": false,
    "use_mavlink": true,
    "exp_pgfuzz": false,
    "flight_mode": "POSCTL"
  }
}
