{
  "name": "moveit2",
  "basic": {
    "ros_pkg": "moveit2_tutorials",
    "ros_node": "move_group"
  },
  "lifecycle": {
    "managed": true,
    "warmup_sec": 15.0,
    "install_script": "install.sh",
    "verify_cmd": "ros2 pkg prefix moveit2_tutorials >/dev/null",
    "skip_ros_pkg_check": false,
    "start_cmd": "bash -lc \"DISPLAY=${DISPLAY:-:0} ros2 launch moveit2_tutorials demo.launch.py\"",
    "stop_cmd": "pkill -f \"demo.launch.py\" || true; pkill -f \"move_group.launch.py\" || true; pkill -f \"move_group\" || true"
  },
  "fuzzing": {
    "default_topic": "/metatopic",
    "default_msg_type": "geometry_msgs/msg/Pose",
    "field_whitelist": [
      [
        "position",
        "x",
        "float64"
      ],
      [
        "position",
        "y",
        "float64"
      ],
      [
        "position",
        "z",
        "float64"
      ]
    ],
    "feedback": [
      {
        "name": "end_point_deviation",
        "type": "INC",
        "default": 0.0
      },
      {
        "name": "mean_joint_pos_error",
        "type": "INC",
        "default": 0.0
      },
      {
        "name": "max_joint_pos_error",
        "type": "INC",
        "default": 0.0
      },
      {
        "name": "mean_joint_vel_error",
        "type": "INC",
        "default": 0.0
      },
      {
        "name": "max_joint_vel_error",
        "type": "INC",
        "default": 0.0
      }
    ]
  },
  "monitoring": {
    "watchlist": "watchlist.json",
    "plugin": "plugin.py"
  },
  "runtime": {
    "test_moveit": true
  }
}
