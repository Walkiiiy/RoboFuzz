{
  "name": "px4_sitl_ros",
  "basic": {
    "ros_pkg": "px4",
    "ros_node": "drone"
  },
  "lifecycle": {
    "managed": false,
    "warmup_sec": 10.0
  },
  "fuzzing": {
    "default_topic": "/TrajectorySetpoint_PubSubTopic",
    "default_msg_type": "px4_msgs/msg/TrajectorySetpoint",
    "field_whitelist": [
      ["yaw", "float64"],
      ["yawspeed", "float64"],
      ["vx", "float64"],
      ["vy", "float64"],
      ["vz", "float64"]
    ],
    "feedback": [
      {"name": "imu_accel_inconsistency", "type": "INC"},
      {"name": "imu_gyro_inconsistency", "type": "INC"},
      {"name": "gps_lat_inconsistency", "type": "INC"},
      {"name": "gps_lon_inconsistency", "type": "INC"}
    ]
  },
  "monitoring": {
    "watchlist": "../../watchlist/px4.json"
  },
  "runtime": {
    "px4_sitl": true,
    "px4_ros": true,
    "use_mavlink": false,
    "exp_pgfuzz": false,
    "flight_mode": "OFFBOARD"
  }
}
