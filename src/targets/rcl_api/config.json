{
  "name": "rcl_api",
  "basic": {
    "ros_pkg": "rcl_harness",
    "ros_node": "rcl_harness"
  },
  "lifecycle": {
    "managed": false,
    "warmup_sec": 2.0,
    "install_script": "install.sh",
    "verify_cmd": "python3 -c \"import rclpy\"",
    "skip_ros_pkg_check": true
  },
  "fuzzing": {
    "default_topic": "rcl_topic",
    "default_msg_type": "std_msgs/msg/String"
  },
  "monitoring": {
    "watchlist": "../../watchlist/empty.json"
  },
  "runtime": {
    "test_rcl": true,
    "test_rcl_feature": [
      "publisher"
    ],
    "test_rcl_targets": [
      "py",
      "cpp"
    ],
    "test_rcl_job": "create_publisher"
  }
}
