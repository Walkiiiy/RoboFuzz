{
  "name": "turtlesim",
  "basic": {
    "ros_pkg": "turtlesim",
    "ros_node": "turtlesim_node"
  },
  "lifecycle": {
    "managed": true,
    "warmup_sec": 1.0,
    "install_script": "install.sh",
    "verify_cmd": "ros2 pkg prefix turtlesim >/dev/null && python3 -c \"import turtlesim.msg\"",
    "skip_ros_pkg_check": false,
    "start_cmd": "ros2 run turtlesim turtlesim_node",
    "stop_cmd": "pkill -f \"turtlesim_node\" || true"
  },
  "fuzzing": {
    "default_topic": "/turtle1/cmd_vel",
    "default_msg_type": "geometry_msgs/msg/Twist",
    "field_whitelist": [
      [
        "linear",
        "x",
        "float64"
      ],
      [
        "linear",
        "y",
        "float64"
      ],
      [
        "angular",
        "z",
        "float64"
      ]
    ]
  },
  "monitoring": {
    "watchlist": "watchlist.json",
    "plugin": "plugin.py"
  }
}
