{
  "name": "cli_api",
  "basic": {
    "ros_pkg": "cli_harness",
    "ros_node": "cli_harness"
  },
  "lifecycle": {
    "managed": true,
    "warmup_sec": 2.0,
    "install_script": "install.sh",
    "verify_cmd": "python3 -c \"import rclpy\"",
    "skip_ros_pkg_check": true,
    "start_cmd": "python3 cli_harness.py",
    "stop_cmd": "pkill -f \"cli_harness.py\" || true"
  },
  "fuzzing": {
    "default_topic": "cli_topic",
    "default_msg_type": "std_msgs/msg/String"
  },
  "monitoring": {
    "watchlist": "watchlist.json",
    "plugin": "plugin.py"
  },
  "runtime": {
    "test_cli": true
  }
}
