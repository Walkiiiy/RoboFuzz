{
  "name": "turtlebot3_hitl",
  "basic": {
    "ros_pkg": "turtlebot3_bringup",
    "ros_node": "turtlebot3_node"
  },
  "lifecycle": {
    "managed": true,
    "warmup_sec": 10.0,
    "install_script": "install.sh",
    "verify_cmd": "ros2 pkg prefix turtlebot3_bringup >/dev/null",
    "skip_ros_pkg_check": false,
    "start_cmd": "bash -lc \"ssh -i keys/tb3 ${TB3_URI:-ubuntu@192.168.0.154} ./run.sh\"",
    "stop_cmd": "bash -lc \"ssh -i keys/tb3 ${TB3_URI:-ubuntu@192.168.0.154} ./kill.sh || true\""
  },
  "fuzzing": {
    "default_topic": "/cmd_vel",
    "default_msg_type": "geometry_msgs/msg/Twist",
    "field_whitelist": [
      [
        "linear",
        "x",
        "float64"
      ],
      [
        "angular",
        "z",
        "float64"
      ]
    ],
    "feedback": [
      {
        "name": "theta_diff",
        "type": "INC"
      }
    ]
  },
  "monitoring": {
    "watchlist": "watchlist.json",
    "plugin": "plugin.py"
  },
  "runtime": {
    "tb3_hitl": true,
    "tb3_uri": "ubuntu@192.168.0.154"
  }
}
