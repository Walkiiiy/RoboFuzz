{
  "name": "turtlebot3_hitl",
  "basic": {
    "ros_pkg": "turtlebot3_bringup",
    "ros_node": "turtlebot3_node"
  },
  "lifecycle": {
    "managed": false,
    "warmup_sec": 10.0
  },
  "fuzzing": {
    "default_topic": "/cmd_vel",
    "default_msg_type": "geometry_msgs/msg/Twist",
    "field_whitelist": [
      ["linear", "x", "float64"],
      ["angular", "z", "float64"]
    ],
    "feedback": [
      {"name": "theta_diff", "type": "INC"}
    ]
  },
  "monitoring": {
    "watchlist": "../../watchlist/turtlebot3.json"
  },
  "runtime": {
    "tb3_hitl": true,
    "tb3_uri": "ubuntu@192.168.0.154"
  }
}
