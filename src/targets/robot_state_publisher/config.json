{
  "name": "robot_state_publisher",
  "basic": {
    "ros_pkg": "robot_state_publisher",
    "ros_node": "robot_state_publisher"
  },
  "lifecycle": {
    "managed": true,
    "warmup_sec": 3.0,
    "install_script": "install.sh",
    "verify_cmd": "ros2 pkg prefix robot_state_publisher >/dev/null && ros2 interface show sensor_msgs/msg/JointState >/dev/null && ros2 interface show tf2_msgs/msg/TFMessage >/dev/null",
    "skip_ros_pkg_check": false,
    "start_cmd": "bash start.sh",
    "stop_cmd": ""
  },
  "fuzzing": {
    "default_topic": "/joint_states",
    "default_msg_type": "sensor_msgs/msg/JointState",
    "field_whitelist": [
      [
        "header",
        "stamp",
        "sec",
        "int32"
      ],
      [
        "header",
        "stamp",
        "nanosec",
        "uint32"
      ]
    ],
    "feedback": [
      {
        "name": "tf_liveness",
        "type": "ZERO",
        "default": 0.0
      },
      {
        "name": "tf_pair_count",
        "type": "INC",
        "default": 0.0
      }
    ]
  },
  "monitoring": {
    "watchlist": "watchlist.json",
    "plugin": "plugin.py"
  },
  "runtime": {
    "persistent": true,
    "rsp_joint_names": [
      "joint1",
      "joint2"
    ],
    "rsp_default_positions": [
      0.0,
      0.0
    ],
    "rsp_position_limits": [
      [
        -1.57,
        1.57
      ],
      [
        -1.57,
        1.57
      ]
    ],
    "rsp_expected_frames": [
      "link1",
      "link2"
    ],
    "rsp_max_translation": 10.0,
    "rsp_max_frame_jump": 2.5,
    "rsp_position_mutation_delta": 0.12,
    "rsp_velocity_mutation_limit": 0.25,
    "rsp_fault_duplicate_mod": 41,
    "rsp_fault_unknown_name_mod": 59,
    "rsp_fault_truncate_position_mod": 73,
    "rsp_normalize_stamp": true
  }
}
